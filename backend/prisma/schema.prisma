generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  RECEPTION
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

model Hotel {
  id                     Int               @id @default(autoincrement())
  name                   String            @db.VarChar(150)
  publicSlug             String?           @unique @db.VarChar(100)
  publicEnabled          Boolean           @default(false)
  email                  String?           @db.VarChar(150)
  phone                  String?           @db.VarChar(30)
  address                String?           @db.VarChar(255)
  currency               String            @default("EUR") @db.VarChar(3)
  city                   String?           @db.VarChar(100)
  postalCode             String?           @db.VarChar(20)
  country                String            @default("PT") @db.VarChar(2)
  legalName              String?           @db.VarChar(200)
  taxId                  String?           @db.VarChar(30)
  invoiceFooter          String?           @db.Text
  accommodationTaxRateId Int?
  accommodationTaxRate   TaxRate?          @relation("AccommodationTaxRate", fields: [accommodationTaxRateId], references: [id], onDelete: SetNull)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  users                  User[]
  rooms                  Room[]
  guests                 Guest[]
  reservations           Reservation[]
  taxRates               TaxRate[]
  charges                Charge[]
  payments               Payment[]
  invoiceSeries          InvoiceSeries[]
  invoices               Invoice[]
  cashRegisters          CashRegister[]
  productCategories      ProductCategory[]
  products               Product[]
  orders                 Order[]
  suppliers              Supplier[]
  warehouses             Warehouse[]
  emailLogs              EmailLog[]
  receipts               Receipt[]
  purchases              Purchase[]
  employees              Employee[]
  shifts                 Shift[]
  timeEntries            TimeEntry[]

  @@map("hotels")
}

model User {
  id                Int             @id @default(autoincrement())
  name              String          @db.VarChar(150)
  email             String          @unique @db.VarChar(150)
  passwordHash      String          @db.VarChar(255)
  role              UserRole        @default(RECEPTION)
  active            Boolean         @default(true)
  hotelId           Int?
  hotel             Hotel?          @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessions          UserSession[]
  reservations      Reservation[]
  charges           Charge[]
  payments          Payment[]
  invoices          Invoice[]
  openedSessions    CashSession[]   @relation("OpenedBy")
  closedSessions    CashSession[]   @relation("ClosedBy")
  cashMovements     CashMovement[]
  receipts          Receipt[]
  orders            Order[]
  stockMovements    StockMovement[]
  purchases         Purchase[]
  employee          Employee?
  timeEntriesEdited TimeEntry[]     @relation("TimeEntryEditedBy")

  @@index([hotelId])
  @@map("users")
}

model Room {
  id            Int           @id @default(autoincrement())
  hotelId       Int
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  number        String        @db.VarChar(20)
  type          String        @db.VarChar(60)
  capacity      Int           @default(2)
  pricePerNight Decimal       @db.Decimal(10, 2)
  status        RoomStatus    @default(AVAILABLE)
  floor         Int?
  description   String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  reservations  Reservation[]

  @@unique([hotelId, number])
  @@map("rooms")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  DESK
  PHONE
  EMAIL
  ONLINE
}

model Guest {
  id             Int           @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  firstName      String        @db.VarChar(100)
  lastName       String        @db.VarChar(100)
  email          String?       @db.VarChar(150)
  phone          String?       @db.VarChar(30)
  documentType   String?       @db.VarChar(30)
  documentNumber String?       @db.VarChar(50)
  nationality    String?       @db.VarChar(60)
  birthDate      DateTime?     @db.Date
  address        String?       @db.VarChar(255)
  taxId          String?       @db.VarChar(30)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  reservations   Reservation[]

  @@index([hotelId, lastName])
  @@index([hotelId, email])
  @@map("guests")
}

model Reservation {
  id            Int               @id @default(autoincrement())
  code          String            @unique @db.VarChar(20)
  hotelId       Int
  hotel         Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guestId       Int
  guest         Guest             @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomId        Int
  room          Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  checkIn       DateTime          @db.Date
  checkOut      DateTime          @db.Date
  adults        Int               @default(1)
  children      Int               @default(0)
  status        ReservationStatus @default(PENDING)
  source        ReservationSource @default(DESK)
  pricePerNight Decimal           @db.Decimal(10, 2)
  totalAmount   Decimal           @db.Decimal(12, 2)
  notes         String?           @db.Text
  checkedInAt   DateTime?
  checkedOutAt  DateTime?
  cancelledAt   DateTime?
  createdById   Int?
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  charges       Charge[]
  payments      Payment[]
  orders        Order[]
  invoices      Invoice[]

  @@index([hotelId, checkIn])
  @@index([hotelId, checkOut])
  @@index([roomId, checkIn, checkOut])
  @@index([guestId])
  @@map("reservations")
}

enum ChargeType {
  ACCOMMODATION
  RESTAURANT
  BAR
  EXTRA
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MOBILE
  OTHER
}

enum InvoiceType {
  INVOICE
  INVOICE_RECEIPT
  CREDIT_NOTE
  RECEIPT
}

enum InvoiceStatus {
  ISSUED
  CREDITED
}

enum CashMovementType {
  IN
  OUT
}

model TaxRate {
  id                  Int         @id @default(autoincrement())
  hotelId             Int
  hotel               Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                String      @db.VarChar(60)
  rate                Decimal     @db.Decimal(5, 2)
  atCategory          TaxCategory @default(NOR)
  exemptionCode       String?     @db.VarChar(3)
  exemptionReason     String?     @db.VarChar(255)
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  accommodationHotels Hotel[]     @relation("AccommodationTaxRate")
  products            Product[]
  orderItems          OrderItem[]
  charges             Charge[]

  @@index([hotelId])
  @@map("tax_rates")
}

model Charge {
  id            Int          @id @default(autoincrement())
  hotelId       Int
  hotel         Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId Int?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  type          ChargeType   @default(EXTRA)
  description   String       @db.VarChar(200)
  quantity      Decimal      @db.Decimal(10, 3)
  unitPrice     Decimal      @db.Decimal(12, 2)
  taxRateId     Int?
  taxRateRef    TaxRate?     @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  taxRate       Decimal      @db.Decimal(5, 2)
  total         Decimal      @db.Decimal(12, 2)
  invoiceId     Int?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  sourceRef     String?      @db.VarChar(60)
  productCode   String?      @db.VarChar(60)
  orderId       Int?
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdById   Int?
  createdBy     User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([reservationId])
  @@index([invoiceId])
  @@index([hotelId, createdAt])
  @@map("charges")
}

model Payment {
  id            Int           @id @default(autoincrement())
  hotelId       Int
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId Int?
  reservation   Reservation?  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  invoiceId     Int?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  cashSessionId Int?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  receiptId     Int?
  receipt       Receipt?      @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  orderId       Int?
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?       @db.VarChar(100)
  notes         String?       @db.VarChar(255)
  createdById   Int?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@index([reservationId])
  @@index([cashSessionId])
  @@index([hotelId, createdAt])
  @@map("payments")
}

model InvoiceSeries {
  id               Int         @id @default(autoincrement())
  hotelId          Int
  hotel            Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  type             InvoiceType
  code             String      @db.VarChar(20)
  nextNumber       Int         @default(1)
  atValidationCode String?     @db.VarChar(20)
  lastHash         String?     @db.VarChar(255)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  receipts         Receipt[]
  invoices         Invoice[]

  @@unique([hotelId, type, code])
  @@map("invoice_series")
}

model Invoice {
  id              Int           @id @default(autoincrement())
  hotelId         Int
  hotel           Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  seriesId        Int
  series          InvoiceSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  type            InvoiceType
  number          Int
  fullNumber      String        @db.VarChar(40)
  status          InvoiceStatus @default(ISSUED)
  issuedAt        DateTime      @default(now())
  reservationId   Int?
  reservation     Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  creditOfId      Int?
  creditOf        Invoice?      @relation("CreditNotes", fields: [creditOfId], references: [id], onDelete: Restrict)
  creditNotes     Invoice[]     @relation("CreditNotes")
  reason          String?       @db.VarChar(255)
  customerName    String        @db.VarChar(200)
  customerTaxId   String?       @db.VarChar(30)
  customerAddress String?       @db.VarChar(255)
  customerEmail   String?       @db.VarChar(150)
  currency        String        @db.VarChar(3)
  netTotal        Decimal       @db.Decimal(12, 2)
  taxTotal        Decimal       @db.Decimal(12, 2)
  grossTotal      Decimal       @db.Decimal(12, 2)
  previousHash    String?       @db.VarChar(255)
  hash            String        @db.VarChar(255)
  atcud           String?       @db.VarChar(80)
  keyVersion      Int           @default(1)
  createdById     Int?
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines           InvoiceLine[]
  charges         Charge[]
  payments        Payment[]
  receiptLines    ReceiptLine[]

  @@unique([seriesId, number])
  @@index([hotelId, issuedAt])
  @@map("invoices")
}

model InvoiceLine {
  id              Int         @id @default(autoincrement())
  invoiceId       Int
  invoice         Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description     String      @db.VarChar(200)
  quantity        Decimal     @db.Decimal(10, 3)
  unitPrice       Decimal     @db.Decimal(12, 2)
  taxRate         Decimal     @db.Decimal(5, 2)
  productCode     String      @default("GERAL") @db.VarChar(60)
  taxCategory     TaxCategory @default(NOR)
  exemptionCode   String?     @db.VarChar(3)
  exemptionReason String?     @db.VarChar(255)
  netAmount       Decimal     @db.Decimal(12, 2)
  taxAmount       Decimal     @db.Decimal(12, 2)
  grossAmount     Decimal     @db.Decimal(12, 2)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model CashRegister {
  id        Int           @id @default(autoincrement())
  hotelId   Int
  hotel     Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String        @db.VarChar(60)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  sessions  CashSession[]

  @@unique([hotelId, name])
  @@map("cash_registers")
}

model CashSession {
  id             Int            @id @default(autoincrement())
  registerId     Int
  register       CashRegister   @relation(fields: [registerId], references: [id], onDelete: Restrict)
  openedById     Int?
  openedBy       User?          @relation("OpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  openedAt       DateTime       @default(now())
  openingAmount  Decimal        @db.Decimal(12, 2)
  closedById     Int?
  closedBy       User?          @relation("ClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt       DateTime?
  expectedAmount Decimal?       @db.Decimal(12, 2)
  countedAmount  Decimal?       @db.Decimal(12, 2)
  difference     Decimal?       @db.Decimal(12, 2)
  notes          String?        @db.Text
  payments       Payment[]
  movements      CashMovement[]

  @@index([registerId, closedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id          Int              @id @default(autoincrement())
  sessionId   Int
  session     CashSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  description String           @db.VarChar(200)
  createdById Int?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([sessionId])
  @@map("cash_movements")
}

enum Outlet {
  RESTAURANT
  BAR
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  WASTE
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  hotelId   Int
  hotel     Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(80)
  outlet    Outlet?
  sortOrder Int       @default(0)
  products  Product[]

  @@unique([hotelId, name])
  @@map("product_categories")
}

model Product {
  id             Int              @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  categoryId     Int?
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String           @db.VarChar(120)
  sku            String?          @db.VarChar(40)
  unit           String           @default("un") @db.VarChar(10)
  price          Decimal          @default(0) @db.Decimal(12, 2)
  cost           Decimal          @default(0) @db.Decimal(12, 4)
  taxRateId      Int?
  taxRate        TaxRate?         @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  sellable       Boolean          @default(true)
  trackStock     Boolean          @default(false)
  minStock       Decimal          @default(0) @db.Decimal(12, 3)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  orderItems     OrderItem[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  recipeItems    RecipeItem[]     @relation("RecipeDish")
  usedIn         RecipeItem[]     @relation("RecipeIngredient")

  @@unique([hotelId, sku])
  @@index([hotelId, categoryId])
  @@map("products")
}

model Order {
  id             Int             @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  outlet         Outlet
  tableLabel     String?         @db.VarChar(30)
  status         OrderStatus     @default(OPEN)
  reservationId  Int?
  reservation    Reservation?    @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  total          Decimal         @default(0) @db.Decimal(12, 2)
  notes          String?         @db.VarChar(255)
  openedById     Int?
  openedBy       User?           @relation(fields: [openedById], references: [id], onDelete: SetNull)
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  items          OrderItem[]
  charges        Charge[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@index([hotelId, status])
  @@index([hotelId, openedAt])
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  description String   @db.VarChar(120)
  quantity    Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRateId   Int?
  taxRateRef  TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  total       Decimal  @db.Decimal(12, 2)
  notes       String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model Supplier {
  id        Int        @id @default(autoincrement())
  hotelId   Int
  hotel     Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String     @db.VarChar(150)
  taxId     String?    @db.VarChar(30)
  email     String?    @db.VarChar(150)
  phone     String?    @db.VarChar(30)
  address   String?    @db.VarChar(255)
  notes     String?    @db.Text
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  purchases Purchase[]

  @@index([hotelId])
  @@map("suppliers")
}

model Warehouse {
  id             Int             @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name           String          @db.VarChar(80)
  isDefault      Boolean         @default(false)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  purchases      Purchase[]

  @@unique([hotelId, name])
  @@map("warehouses")
}

model StockLevel {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@map("stock_levels")
}

model StockMovement {
  id          Int               @id @default(autoincrement())
  warehouseId Int
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId   Int
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  unitCost    Decimal?          @db.Decimal(12, 4)
  balance     Decimal           @db.Decimal(12, 3)
  reason      String?           @db.VarChar(200)
  orderId     Int?
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseId  Int?
  purchase    Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdById Int?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([warehouseId, productId, createdAt])
  @@map("stock_movements")
}

model Purchase {
  id             Int             @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  supplierId     Int
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId    Int
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status         PurchaseStatus  @default(DRAFT)
  supplierRef    String?         @db.VarChar(60)
  total          Decimal         @default(0) @db.Decimal(12, 2)
  notes          String?         @db.Text
  orderedAt      DateTime        @default(now())
  receivedAt     DateTime?
  createdById    Int?
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items          PurchaseItem[]
  stockMovements StockMovement[]

  @@index([hotelId, status])
  @@map("purchases")
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @db.Decimal(12, 4)
  total      Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@map("purchase_items")
}

model UserSession {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @db.VarChar(64)
  expiresAt  DateTime
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@map("user_sessions")
}

model RecipeItem {
  id           Int     @id @default(autoincrement())
  productId    Int
  product      Product @relation("RecipeDish", fields: [productId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Product @relation("RecipeIngredient", fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal @db.Decimal(12, 3)

  @@unique([productId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_items")
}

enum EmailStatus {
  SENT
  LOGGED
  FAILED
}

model EmailLog {
  id        Int         @id @default(autoincrement())
  hotelId   Int?
  hotel     Hotel?      @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  kind      String      @db.VarChar(40)
  recipient String      @db.VarChar(255)
  subject   String      @db.VarChar(255)
  status    EmailStatus
  error     String?     @db.Text
  relatedId Int?
  createdAt DateTime    @default(now())

  @@index([hotelId, createdAt])
  @@map("email_logs")
}

enum TaxCategory {
  RED
  INT
  NOR
  ISE
}

enum ReceiptStatus {
  ISSUED
  CANCELLED
}

model Receipt {
  id            Int           @id @default(autoincrement())
  hotelId       Int
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  seriesId      Int
  series        InvoiceSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  number        Int
  fullNumber    String        @db.VarChar(40)
  atcud         String?       @db.VarChar(80)
  status        ReceiptStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  customerName  String        @db.VarChar(200)
  customerTaxId String?       @db.VarChar(30)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?       @db.VarChar(100)
  cancelledAt   DateTime?
  cancelReason  String?       @db.VarChar(255)
  createdById   Int?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines         ReceiptLine[]
  payments      Payment[]

  @@unique([seriesId, number])
  @@index([hotelId, issuedAt])
  @@map("receipts")
}

model ReceiptLine {
  id        Int     @id @default(autoincrement())
  receiptId Int
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal @db.Decimal(12, 2)

  @@index([receiptId])
  @@index([invoiceId])
  @@map("receipt_lines")
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  PART_TIME
  INTERN
  OTHER
}

enum TimeEntrySource {
  SELF
  MANAGER
}

model Employee {
  id                   Int          @id @default(autoincrement())
  hotelId              Int
  hotel                Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId               Int?         @unique
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName             String       @db.VarChar(150)
  jobTitle             String       @db.VarChar(80)
  department           String?      @db.VarChar(60)
  email                String?      @db.VarChar(150)
  phone                String?      @db.VarChar(30)
  taxId                String?      @db.VarChar(30)
  socialSecurityNumber String?      @db.VarChar(30)
  iban                 String?      @db.VarChar(40)
  contractType         ContractType @default(PERMANENT)
  startDate            DateTime     @db.Date
  endDate              DateTime?    @db.Date
  weeklyHours          Decimal      @default(40) @db.Decimal(5, 2)
  baseSalary           Decimal?     @db.Decimal(12, 2)
  active               Boolean      @default(true)
  notes                String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  shifts               Shift[]
  timeEntries          TimeEntry[]

  @@index([hotelId, active])
  @@map("employees")
}

model Shift {
  id           Int      @id @default(autoincrement())
  hotelId      Int
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  startTime    String   @db.VarChar(5)
  endTime      String   @db.VarChar(5)
  breakMinutes Int      @default(0)
  notes        String?  @db.VarChar(200)
  createdAt    DateTime @default(now())

  @@index([hotelId, date])
  @@index([employeeId, date])
  @@map("shifts")
}

model TimeEntry {
  id         Int             @id @default(autoincrement())
  hotelId    Int
  hotel      Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn    DateTime
  clockOut   DateTime?
  source     TimeEntrySource @default(SELF)
  notes      String?         @db.VarChar(200)
  editedById Int?
  editedBy   User?           @relation("TimeEntryEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt   DateTime?
  createdAt  DateTime        @default(now())

  @@index([employeeId, clockIn])
  @@index([hotelId, clockIn])
  @@map("time_entries")
}
