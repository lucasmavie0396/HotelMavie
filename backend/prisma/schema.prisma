generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  RECEPTION
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

model Hotel {
  id                     Int               @id @default(autoincrement())
  name                   String            @db.VarChar(150)
  publicSlug             String?           @unique @db.VarChar(100)
  publicEnabled          Boolean           @default(false)
  customDomain           String?           @unique @db.VarChar(253)
  email                  String?           @db.VarChar(150)
  phone                  String?           @db.VarChar(30)
  address                String?           @db.VarChar(255)
  currency               String            @default("EUR") @db.VarChar(3)
  city                   String?           @db.VarChar(100)
  postalCode             String?           @db.VarChar(20)
  country                String            @default("PT") @db.VarChar(2)
  legalName              String?           @db.VarChar(200)
  taxId                  String?           @db.VarChar(30)
  invoiceFooter          String?           @db.Text
  ticketFooter           String?           @db.VarChar(255)
  logoFile               String?           @db.VarChar(100)
  publicDescription      String?           @db.Text
  depositPercent         Decimal           @default(60) @db.Decimal(5, 2)
  paymentInstructions    String?           @db.Text
  accommodationTaxRateId Int?
  accommodationTaxRate   TaxRate?          @relation("AccommodationTaxRate", fields: [accommodationTaxRateId], references: [id], onDelete: SetNull)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  users                  User[]
  rooms                  Room[]
  guests                 Guest[]
  reservations           Reservation[]
  taxRates               TaxRate[]
  charges                Charge[]
  payments               Payment[]
  invoiceSeries          InvoiceSeries[]
  invoices               Invoice[]
  cashRegisters          CashRegister[]
  productCategories      ProductCategory[]
  products               Product[]
  orders                 Order[]
  suppliers              Supplier[]
  warehouses             Warehouse[]
  emailLogs              EmailLog[]
  receipts               Receipt[]
  purchases              Purchase[]
  stockDocuments         StockDocument[]
  stockDocumentSeries    StockDocumentSeries[]
  auditLogs              AuditLog[]
  employees              Employee[]
  shifts                 Shift[]
  timeEntries            TimeEntry[]
  printers               Printer[]
  paymentTypes           PaymentType[]
  diningTables           DiningTable[]

  @@map("hotels")
}

model User {
  id                Int             @id @default(autoincrement())
  name              String          @db.VarChar(150)
  email             String          @unique @db.VarChar(150)
  passwordHash      String          @db.VarChar(255)
  role              UserRole        @default(RECEPTION)
  active            Boolean         @default(true)
  hotelId           Int?
  hotel             Hotel?          @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  totpSecret        String?         @db.VarChar(255)
  totpEnabled       Boolean         @default(false)
  totpLastStep      Int?
  totpRecoveryCodes Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessions          UserSession[]
  passwordResets    PasswordReset[]
  auditLogs         AuditLog[]
  reservations      Reservation[]
  charges           Charge[]
  payments          Payment[]
  invoices          Invoice[]
  openedSessions    CashSession[]   @relation("OpenedBy")
  closedSessions    CashSession[]   @relation("ClosedBy")
  cashMovements     CashMovement[]
  receipts          Receipt[]
  orders            Order[]
  stockMovements    StockMovement[]
  purchases         Purchase[]
  stockDocuments    StockDocument[]
  employee          Employee?
  timeEntriesEdited TimeEntry[]     @relation("TimeEntryEditedBy")
  voidedOrderItems  OrderItem[]     @relation("OrderItemVoidedBy")
  depositsConfirmed Reservation[]   @relation("DepositConfirmedBy")

  @@index([hotelId])
  @@map("users")
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  hotelId   Int?
  hotel     Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(40)
  entityId  Int?
  summary   String   @db.VarChar(255)
  data      Json?
  createdAt DateTime @default(now())

  @@index([hotelId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model Room {
  id            Int           @id @default(autoincrement())
  hotelId       Int
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  number        String        @db.VarChar(20)
  type          String        @db.VarChar(60)
  capacity      Int           @default(2)
  pricePerNight Decimal       @db.Decimal(10, 2)
  status        RoomStatus    @default(AVAILABLE)
  floor         Int?
  description   String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  reservations  Reservation[]
  images        RoomImage[]

  @@unique([hotelId, number])
  @@map("rooms")
}

model RoomImage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  file      String   @db.VarChar(100)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([roomId])
  @@map("room_images")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  DESK
  PHONE
  EMAIL
  ONLINE
}

model Guest {
  id             Int           @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  firstName      String        @db.VarChar(100)
  lastName       String        @db.VarChar(100)
  email          String?       @db.VarChar(150)
  phone          String?       @db.VarChar(30)
  documentType   String?       @db.VarChar(30)
  documentNumber String?       @db.VarChar(50)
  nationality    String?       @db.VarChar(60)
  birthDate      DateTime?     @db.Date
  address        String?       @db.VarChar(255)
  taxId          String?       @db.VarChar(30)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  reservations   Reservation[]

  @@index([hotelId, lastName])
  @@index([hotelId, email])
  @@map("guests")
}

model Reservation {
  id                   Int                    @id @default(autoincrement())
  code                 String                 @unique @db.VarChar(20)
  hotelId              Int
  hotel                Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guestId              Int
  guest                Guest                  @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomId               Int
  room                 Room                   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  checkIn              DateTime               @db.Date
  checkOut             DateTime               @db.Date
  adults               Int                    @default(1)
  children             Int                    @default(0)
  status               ReservationStatus      @default(PENDING)
  source               ReservationSource      @default(DESK)
  pricePerNight        Decimal                @db.Decimal(10, 2)
  totalAmount          Decimal                @db.Decimal(12, 2)
  notes                String?                @db.Text
  checkedInAt          DateTime?
  checkedOutAt         DateTime?
  cancelledAt          DateTime?
  depositAmount        Decimal?               @db.Decimal(12, 2)
  depositReference     String?                @db.VarChar(100)
  depositPaymentTypeId Int?
  depositPaymentType   PaymentType?           @relation(fields: [depositPaymentTypeId], references: [id], onDelete: SetNull)
  depositPaymentId     Int?                   @unique
  depositPayment       Payment?               @relation("DepositPayment", fields: [depositPaymentId], references: [id], onDelete: SetNull)
  depositConfirmedAt   DateTime?
  depositConfirmedById Int?
  depositConfirmedBy   User?                  @relation("DepositConfirmedBy", fields: [depositConfirmedById], references: [id], onDelete: SetNull)
  createdById          Int?
  createdBy            User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  charges              Charge[]
  payments             Payment[]
  orders               Order[]
  invoices             Invoice[]
  companions           ReservationCompanion[]

  @@index([hotelId, checkIn])
  @@index([hotelId, checkOut])
  @@index([roomId, checkIn, checkOut])
  @@index([guestId])
  @@map("reservations")
}

model ReservationCompanion {
  id             Int         @id @default(autoincrement())
  reservationId  Int
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  firstName      String      @db.VarChar(100)
  lastName       String      @db.VarChar(100)
  isChild        Boolean     @default(false)
  birthDate      DateTime?   @db.Date
  nationality    String?     @db.VarChar(60)
  documentType   String?     @db.VarChar(30)
  documentNumber String?     @db.VarChar(50)
  createdAt      DateTime    @default(now())

  @@index([reservationId])
  @@map("reservation_companions")
}

enum ChargeType {
  ACCOMMODATION
  RESTAURANT
  BAR
  EXTRA
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MOBILE
  OTHER
}

enum InvoiceType {
  INVOICE
  INVOICE_RECEIPT
  CREDIT_NOTE
  RECEIPT
}

enum InvoiceStatus {
  ISSUED
  CREDITED
}

enum CashMovementType {
  IN
  OUT
}

model TaxRate {
  id                  Int         @id @default(autoincrement())
  hotelId             Int
  hotel               Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                String      @db.VarChar(60)
  rate                Decimal     @db.Decimal(5, 2)
  atCategory          TaxCategory @default(NOR)
  exemptionCode       String?     @db.VarChar(3)
  exemptionReason     String?     @db.VarChar(255)
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  accommodationHotels Hotel[]     @relation("AccommodationTaxRate")
  products            Product[]
  orderItems          OrderItem[]
  charges             Charge[]

  @@index([hotelId])
  @@map("tax_rates")
}

model Charge {
  id            Int          @id @default(autoincrement())
  hotelId       Int
  hotel         Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId Int?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  type          ChargeType   @default(EXTRA)
  description   String       @db.VarChar(200)
  quantity      Decimal      @db.Decimal(10, 3)
  unitPrice     Decimal      @db.Decimal(12, 2)
  taxRateId     Int?
  taxRateRef    TaxRate?     @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  taxRate       Decimal      @db.Decimal(5, 2)
  total         Decimal      @db.Decimal(12, 2)
  invoiceId     Int?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  sourceRef     String?      @db.VarChar(60)
  productCode   String?      @db.VarChar(60)
  orderId       Int?
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdById   Int?
  createdBy     User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([reservationId])
  @@index([invoiceId])
  @@index([hotelId, createdAt])
  @@map("charges")
}

model Payment {
  id            Int           @id @default(autoincrement())
  hotelId       Int
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId Int?
  reservation   Reservation?  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  invoiceId     Int?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  cashSessionId Int?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  receiptId     Int?
  receipt       Receipt?      @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  orderId       Int?
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  paymentTypeId Int?
  paymentType   PaymentType?  @relation(fields: [paymentTypeId], references: [id], onDelete: SetNull)
  reference     String?       @db.VarChar(100)
  notes         String?       @db.VarChar(255)
  createdById   Int?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  depositOf     Reservation?  @relation("DepositPayment")

  @@index([reservationId])
  @@index([cashSessionId])
  @@index([hotelId, createdAt])
  @@map("payments")
}

model InvoiceSeries {
  id               Int         @id @default(autoincrement())
  hotelId          Int
  hotel            Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  type             InvoiceType
  code             String      @db.VarChar(20)
  nextNumber       Int         @default(1)
  atValidationCode String?     @db.VarChar(20)
  lastHash         String?     @db.VarChar(255)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  receipts         Receipt[]
  invoices         Invoice[]

  @@unique([hotelId, type, code])
  @@map("invoice_series")
}

model Invoice {
  id              Int           @id @default(autoincrement())
  hotelId         Int
  hotel           Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  seriesId        Int
  series          InvoiceSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  type            InvoiceType
  number          Int
  fullNumber      String        @db.VarChar(40)
  status          InvoiceStatus @default(ISSUED)
  issuedAt        DateTime      @default(now())
  reservationId   Int?
  reservation     Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  creditOfId      Int?
  creditOf        Invoice?      @relation("CreditNotes", fields: [creditOfId], references: [id], onDelete: Restrict)
  creditNotes     Invoice[]     @relation("CreditNotes")
  reason          String?       @db.VarChar(255)
  customerName    String        @db.VarChar(200)
  customerTaxId   String?       @db.VarChar(30)
  customerAddress String?       @db.VarChar(255)
  customerEmail   String?       @db.VarChar(150)
  currency        String        @db.VarChar(3)
  netTotal        Decimal       @db.Decimal(12, 2)
  taxTotal        Decimal       @db.Decimal(12, 2)
  grossTotal      Decimal       @db.Decimal(12, 2)
  previousHash    String?       @db.VarChar(255)
  hash            String        @db.VarChar(255)
  atcud           String?       @db.VarChar(80)
  keyVersion      Int           @default(1)
  createdById     Int?
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines           InvoiceLine[]
  charges         Charge[]
  payments        Payment[]
  receiptLines    ReceiptLine[]

  @@unique([seriesId, number])
  @@index([hotelId, issuedAt])
  @@map("invoices")
}

model InvoiceLine {
  id              Int         @id @default(autoincrement())
  invoiceId       Int
  invoice         Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description     String      @db.VarChar(200)
  quantity        Decimal     @db.Decimal(10, 3)
  unitPrice       Decimal     @db.Decimal(12, 2)
  taxRate         Decimal     @db.Decimal(5, 2)
  productCode     String      @default("GERAL") @db.VarChar(60)
  taxCategory     TaxCategory @default(NOR)
  exemptionCode   String?     @db.VarChar(3)
  exemptionReason String?     @db.VarChar(255)
  netAmount       Decimal     @db.Decimal(12, 2)
  taxAmount       Decimal     @db.Decimal(12, 2)
  grossAmount     Decimal     @db.Decimal(12, 2)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model CashRegister {
  id        Int           @id @default(autoincrement())
  hotelId   Int
  hotel     Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String        @db.VarChar(60)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  sessions  CashSession[]

  @@unique([hotelId, name])
  @@map("cash_registers")
}

model CashSession {
  id             Int            @id @default(autoincrement())
  registerId     Int
  register       CashRegister   @relation(fields: [registerId], references: [id], onDelete: Restrict)
  openedById     Int?
  openedBy       User?          @relation("OpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  openedAt       DateTime       @default(now())
  openingAmount  Decimal        @db.Decimal(12, 2)
  closedById     Int?
  closedBy       User?          @relation("ClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt       DateTime?
  expectedAmount Decimal?       @db.Decimal(12, 2)
  countedAmount  Decimal?       @db.Decimal(12, 2)
  difference     Decimal?       @db.Decimal(12, 2)
  notes          String?        @db.Text
  payments       Payment[]
  movements      CashMovement[]

  @@index([registerId, closedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id          Int              @id @default(autoincrement())
  sessionId   Int
  session     CashSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  description String           @db.VarChar(200)
  createdById Int?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([sessionId])
  @@map("cash_movements")
}

enum Outlet {
  RESTAURANT
  BAR
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  WASTE
  RETURN
}

enum PurchaseStatus {
  DRAFT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum StockDocumentType {
  INVENTORY
  WASTE
  TRANSFER
  RETURN
}

enum StockDocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

model ProductCategory {
  id          Int         @id @default(autoincrement())
  hotelId     Int
  hotel       Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String      @db.VarChar(80)
  outlet      Outlet?
  prepStation PrepStation @default(KITCHEN)
  printerId   Int?
  printer     Printer?    @relation(fields: [printerId], references: [id], onDelete: SetNull)
  sortOrder   Int         @default(0)
  products    Product[]

  @@unique([hotelId, name])
  @@map("product_categories")
}

model Product {
  id             Int              @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  categoryId     Int?
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String           @db.VarChar(120)
  sku            String?          @db.VarChar(40)
  unit           String           @default("un") @db.VarChar(10)
  price          Decimal          @default(0) @db.Decimal(12, 2)
  cost           Decimal          @default(0) @db.Decimal(12, 4)
  taxRateId      Int?
  taxRate        TaxRate?         @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  sellable       Boolean          @default(true)
  trackStock     Boolean          @default(false)
  trackExpiry    Boolean          @default(false)
  minStock       Decimal          @default(0) @db.Decimal(12, 3)
  imageFile      String?          @db.VarChar(100)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  orderItems     OrderItem[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  stockDocItems  StockDocumentItem[]
  stockLots      StockLot[]
  recipeItems    RecipeItem[]     @relation("RecipeDish")
  usedIn         RecipeItem[]     @relation("RecipeIngredient")

  @@unique([hotelId, sku])
  @@index([hotelId, categoryId])
  @@map("products")
}

model Order {
  id             Int             @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  outlet         Outlet
  tableLabel     String?         @db.VarChar(30)
  tableId        Int?
  table          DiningTable?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  status         OrderStatus     @default(OPEN)
  reservationId  Int?
  reservation    Reservation?    @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  total          Decimal         @default(0) @db.Decimal(12, 2)
  notes          String?         @db.VarChar(255)
  openedById     Int?
  openedBy       User?           @relation(fields: [openedById], references: [id], onDelete: SetNull)
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  items          OrderItem[]
  charges        Charge[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@index([hotelId, status])
  @@index([hotelId, openedAt])
  @@index([tableId, status])
  @@map("orders")
}

model DiningTable {
  id        Int      @id @default(autoincrement())
  hotelId   Int
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  outlet    Outlet
  number    Int
  name      String?  @db.VarChar(40)
  seats     Int      @default(4)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]

  @@unique([hotelId, outlet, number])
  @@map("dining_tables")
}

model OrderItem {
  id          Int       @id @default(autoincrement())
  orderId     Int
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  description String    @db.VarChar(120)
  quantity    Decimal   @db.Decimal(10, 3)
  unitPrice   Decimal   @db.Decimal(12, 2)
  taxRateId   Int?
  taxRateRef  TaxRate?  @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  total       Decimal   @db.Decimal(12, 2)
  notes       String?   @db.VarChar(255)
  sentAt      DateTime?
  readyAt     DateTime?
  voidedAt    DateTime?
  voidReason  String?   @db.VarChar(200)
  voidedById  Int?
  voidedBy    User?     @relation("OrderItemVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([orderId])
  @@map("order_items")
}

enum PrepStation {
  KITCHEN
  BAR
  NONE
}

model Supplier {
  id        Int        @id @default(autoincrement())
  hotelId   Int
  hotel     Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String     @db.VarChar(150)
  taxId     String?    @db.VarChar(30)
  email     String?    @db.VarChar(150)
  phone     String?    @db.VarChar(30)
  address   String?    @db.VarChar(255)
  notes     String?    @db.Text
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  purchases Purchase[]
  returns   StockDocument[]

  @@index([hotelId])
  @@map("suppliers")
}

model Warehouse {
  id             Int             @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name           String          @db.VarChar(80)
  isDefault      Boolean         @default(false)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  purchases      Purchase[]
  stockDocuments StockDocument[] @relation("StockDocumentFrom")
  transfersIn    StockDocument[] @relation("StockDocumentTo")
  stockLots      StockLot[]

  @@unique([hotelId, name])
  @@map("warehouses")
}

model StockLevel {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@map("stock_levels")
}

model StockMovement {
  id          Int               @id @default(autoincrement())
  warehouseId Int
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId   Int
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  unitCost    Decimal?          @db.Decimal(12, 4)
  balance     Decimal           @db.Decimal(12, 3)
  reason      String?           @db.VarChar(200)
  orderId     Int?
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseId  Int?
  purchase    Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  documentId  Int?
  document    StockDocument?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdById Int?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([warehouseId, productId, createdAt])
  @@map("stock_movements")
}

model Purchase {
  id             Int             @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  supplierId     Int
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId    Int
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status         PurchaseStatus  @default(DRAFT)
  supplierRef    String?         @db.VarChar(60)
  total          Decimal         @default(0) @db.Decimal(12, 2)
  notes          String?         @db.Text
  orderedAt      DateTime        @default(now())
  sentAt         DateTime?
  receivedAt     DateTime?
  createdById    Int?
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items          PurchaseItem[]
  stockMovements StockMovement[]

  @@index([hotelId, status])
  @@map("purchases")
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Decimal  @db.Decimal(12, 3)
  receivedQuantity Decimal  @default(0) @db.Decimal(12, 3)
  unitCost         Decimal  @db.Decimal(12, 4)
  total            Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@map("purchase_items")
}

model StockDocument {
  id             Int                 @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  type           StockDocumentType
  status         StockDocumentStatus @default(DRAFT)
  year           Int?
  number         Int?
  warehouseId    Int
  warehouse      Warehouse           @relation("StockDocumentFrom", fields: [warehouseId], references: [id], onDelete: Restrict)
  toWarehouseId  Int?
  toWarehouse    Warehouse?          @relation("StockDocumentTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  supplierId     Int?
  supplier       Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  reason         String?             @db.VarChar(200)
  createdById    Int?
  createdBy      User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  postedAt       DateTime?
  items          StockDocumentItem[]
  stockMovements StockMovement[]

  @@unique([hotelId, type, year, number])
  @@index([hotelId, type, status])
  @@index([warehouseId])
  @@map("stock_documents")
}

model StockDocumentSeries {
  id         Int               @id @default(autoincrement())
  hotelId    Int
  hotel      Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  type       StockDocumentType
  year       Int
  nextNumber Int               @default(1)

  @@unique([hotelId, type, year])
  @@map("stock_document_series")
}

model StockLot {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  code        String?   @db.VarChar(40)
  expiryDate  DateTime? @db.Date
  quantity    Decimal   @db.Decimal(12, 3)
  createdAt   DateTime  @default(now())

  @@index([warehouseId, productId])
  @@index([expiryDate])
  @@map("stock_lots")
}

model StockDocumentItem {
  id               Int           @id @default(autoincrement())
  documentId       Int
  document         StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Decimal       @db.Decimal(12, 3)
  previousQuantity Decimal?      @db.Decimal(12, 3)

  @@index([documentId])
  @@map("stock_document_items")
}

model UserSession {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @db.VarChar(64)
  previousTokenHash String?   @db.VarChar(64)
  rotatedAt         DateTime?
  expiresAt         DateTime
  userAgent         String?   @db.VarChar(255)
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())

  @@index([userId])
  @@index([previousTokenHash])
  @@map("user_sessions")
}

model RecipeItem {
  id           Int     @id @default(autoincrement())
  productId    Int
  product      Product @relation("RecipeDish", fields: [productId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Product @relation("RecipeIngredient", fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal @db.Decimal(12, 3)

  @@unique([productId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_items")
}

enum EmailStatus {
  SENT
  LOGGED
  FAILED
}

model EmailLog {
  id        Int         @id @default(autoincrement())
  hotelId   Int?
  hotel     Hotel?      @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  kind      String      @db.VarChar(40)
  recipient String      @db.VarChar(255)
  subject   String      @db.VarChar(255)
  status    EmailStatus
  error     String?     @db.Text
  relatedId Int?
  createdAt DateTime    @default(now())

  @@index([hotelId, createdAt])
  @@map("email_logs")
}

enum TaxCategory {
  RED
  INT
  NOR
  ISE
}

enum ReceiptStatus {
  ISSUED
  CANCELLED
}

model Receipt {
  id            Int           @id @default(autoincrement())
  hotelId       Int
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  seriesId      Int
  series        InvoiceSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  number        Int
  fullNumber    String        @db.VarChar(40)
  atcud         String?       @db.VarChar(80)
  status        ReceiptStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  customerName  String        @db.VarChar(200)
  customerTaxId String?       @db.VarChar(30)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  paymentTypeId Int?
  paymentType   PaymentType?  @relation(fields: [paymentTypeId], references: [id], onDelete: SetNull)
  reference     String?       @db.VarChar(100)
  cancelledAt   DateTime?
  cancelReason  String?       @db.VarChar(255)
  createdById   Int?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines         ReceiptLine[]
  payments      Payment[]

  @@unique([seriesId, number])
  @@index([hotelId, issuedAt])
  @@map("receipts")
}

model ReceiptLine {
  id        Int     @id @default(autoincrement())
  receiptId Int
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal @db.Decimal(12, 2)

  @@index([receiptId])
  @@index([invoiceId])
  @@map("receipt_lines")
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  PART_TIME
  INTERN
  OTHER
}

enum TimeEntrySource {
  SELF
  MANAGER
}

model Employee {
  id                   Int          @id @default(autoincrement())
  hotelId              Int
  hotel                Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId               Int?         @unique
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName             String       @db.VarChar(150)
  jobTitle             String       @db.VarChar(80)
  department           String?      @db.VarChar(60)
  email                String?      @db.VarChar(150)
  phone                String?      @db.VarChar(30)
  taxId                String?      @db.VarChar(30)
  socialSecurityNumber String?      @db.VarChar(30)
  iban                 String?      @db.VarChar(40)
  contractType         ContractType @default(PERMANENT)
  startDate            DateTime     @db.Date
  endDate              DateTime?    @db.Date
  weeklyHours          Decimal      @default(40) @db.Decimal(5, 2)
  baseSalary           Decimal?     @db.Decimal(12, 2)
  active               Boolean      @default(true)
  notes                String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  shifts               Shift[]
  timeEntries          TimeEntry[]

  @@index([hotelId, active])
  @@map("employees")
}

model Shift {
  id           Int      @id @default(autoincrement())
  hotelId      Int
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  startTime    String   @db.VarChar(5)
  endTime      String   @db.VarChar(5)
  breakMinutes Int      @default(0)
  notes        String?  @db.VarChar(200)
  createdAt    DateTime @default(now())

  @@index([hotelId, date])
  @@index([employeeId, date])
  @@map("shifts")
}

model TimeEntry {
  id         Int             @id @default(autoincrement())
  hotelId    Int
  hotel      Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn    DateTime
  clockOut   DateTime?
  source     TimeEntrySource @default(SELF)
  notes      String?         @db.VarChar(200)
  editedById Int?
  editedBy   User?           @relation("TimeEntryEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt   DateTime?
  createdAt  DateTime        @default(now())

  @@index([employeeId, clockIn])
  @@index([hotelId, clockIn])
  @@map("time_entries")
}

enum PrinterPurpose {
  RECEIPT
  KITCHEN
  BAR
  OTHER
}

enum PrinterConnection {
  BROWSER
  NETWORK
  LOCAL
}

enum PrinterOutput {
  DIRECT
  PDF
}

enum PaperWidth {
  MM58
  MM80
  A4
}

model Printer {
  id         Int               @id @default(autoincrement())
  hotelId    Int
  hotel      Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name       String            @db.VarChar(60)
  purpose    PrinterPurpose
  connection PrinterConnection @default(BROWSER)
  host       String?           @db.VarChar(100)
  port       Int               @default(9100)
  localName  String?           @db.VarChar(200)
  paperWidth PaperWidth        @default(MM80)
  output     PrinterOutput     @default(DIRECT)
  copies     Int               @default(1)
  isDefault  Boolean           @default(false)
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  categories ProductCategory[]

  @@unique([hotelId, name])
  @@index([hotelId, purpose])
  @@map("printers")
}

model PaymentType {
  id                Int           @id @default(autoincrement())
  hotelId           Int
  hotel             Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name              String        @db.VarChar(60)
  kind              PaymentMethod
  mechanism         String?       @db.VarChar(2)
  requiresReference Boolean       @default(false)
  active            Boolean       @default(true)
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  payments          Payment[]
  receipts          Receipt[]
  deposits          Reservation[]

  @@unique([hotelId, name])
  @@map("payment_types")
}
